# Plantilla de configuración. Copiar a .env en la raíz del repo (junto a
# docker-compose.yml). El .env NO va dentro de la imagen y está en .gitignore.
#
# ##########################################################################
# #  TODOS LOS VALORES DE ABAJO SON PLACEHOLDERS INVÁLIDOS A PROPÓSITO.    #
# #  Reemplazalos SIEMPRE. No copies este archivo tal cual a producción.   #
# #                                                                        #
# #  El 2026-07-21 se descubrió que la base de producción estaba usando    #
# #  literalmente el usuario y las contraseñas de ejemplo de este archivo,  #
# #  que es público en GitHub. Por eso ahora los ejemplos son obviamente    #
# #  inutilizables: si alguien los copia sin pensar, la app no arranca en   #
# #  lugar de arrancar insegura.                                            #
# ##########################################################################
#
# Docker Compose (servicio web) usa env_file: ./.env: inyecta estas variables en el
# contenedor. Django las lee del entorno del proceso (y read_env como respaldo).
#
# Despliegue en producción:
# - DJANGO_DEBUG=False y una DJANGO_SECRET_KEY única.
# - Aplicar cambios de .env: docker compose up -d --force-recreate web
#   (restart NO recarga env_file; hay que recrear el contenedor).
# - Tras cambiar SECRET_KEY, las sesiones existentes caducan (todos vuelven a entrar).
# - Verificar antes de abrir: docker compose exec web python manage.py check --deploy

# Configuración de la Base de Datos
DB_HOST=db  # Importante: el host es el nombre del servicio en docker-compose
DB_NAME=CAMBIAR_nombre_de_la_base
DB_PORT=3306
DB_USER=CAMBIAR_usuario
# Generar con: openssl rand -base64 24
DB_PASSWORD=CAMBIAR_generar_una_contrasena_unica
DB_ROOT_PASSWORD=CAMBIAR_generar_otra_contrasena_unica
# Reutilizar la conexión (segundos). 0 = conexión nueva por request.
DB_CONN_MAX_AGE=60

# Configuración de Django
# Generar con:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=CAMBIAR_generar_una_clave_unica_de_50_caracteres_o_mas
# Producción: False. Desarrollo local: True
DJANGO_DEBUG=False
DJANGO_SETTINGS_MODULE=web.settings
# Hosts permitidos, separados por coma. NUNCA usar '*' en producción.
DJANGO_ALLOWED_HOSTS=ejemplo.com,www.ejemplo.com,localhost,127.0.0.1

# Cookies: definir en producción con el dominio real, precedido de punto.
SESSION_COOKIE_DOMAIN=.ejemplo.com
CSRF_COOKIE_DOMAIN=.ejemplo.com

# Pantalla de mantenimiento (503). También se activa creando el archivo
# web/.maintenance_on, que no requiere reiniciar nada.
MAINTENANCE_MODE=False

# Límite de intentos fallidos de login antes del bloqueo temporal (django-axes)
AXES_FAILURE_LIMIT=8
AXES_COOLOFF_MINUTES=30

# Configuración del Bot de Telegram (opcional; hoy sin uso)
TELEGRAM_BOT_TOKEN=CAMBIAR_token_del_bot
ADMIN_CHAT_ID=CAMBIAR_chat_id_del_administrador

# Configuración de Mailgun (notificaciones por correo)
MAILGUN_API_KEY=CAMBIAR_api_key_de_mailgun
MAILGUN_DOMAIN=CAMBIAR_dominio.mailgun.org
MAILGUN_BASE_URL=https://api.mailgun.net
MAILGUN_FROM_EMAIL=Nombre <postmaster@CAMBIAR_dominio.mailgun.org>

# Verificación de email
EMAIL_VERIFICATION_MAX_AGE_SECONDS=172800
EMAIL_VERIFICATION_COOLDOWN_SECONDS=300
